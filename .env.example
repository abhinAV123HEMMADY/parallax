# --- Database ---
# Ports are 5433/6380, not the defaults (5432/6379) — docker-compose.yml maps them there
# on purpose since many dev machines already run a native Postgres/Redis on the default ports.
DATABASE_URL=postgresql+asyncpg://parallax:parallax@localhost:5433/parallax
DATABASE_URL_SYNC=postgresql+psycopg://parallax:parallax@localhost:5433/parallax

# --- Redis (Celery broker/backend + WS pub/sub + rate limiting) ---
REDIS_URL=redis://localhost:6380/0

# --- OpenAI API (only needed if you swap the stub agent nodes for real calls) ---
OPENAI_API_KEY=

# --- Embeddings ---
# bge (default) = BAAI/bge-small-en-v1.5 via fastembed, 384-dim, downloaded on first use.
# hash = the old deterministic placeholder. Keeps the project importable where the model can't
# be downloaded, but every similarity ranking under it is noise — don't benchmark against it.
PARALLAX_EMBED=bge

# --- MCP servers (streamable-HTTP transport, local dev ports) ---
VIDEO_MCP_URL=http://localhost:8101/mcp
TUTOR_MCP_URL=http://localhost:8102/mcp
CALENDAR_MCP_URL=http://localhost:8103/mcp
MAPS_MCP_URL=http://localhost:8104/mcp

# --- Backend ---
BACKEND_PORT=8000
# Comma-separated. The Chrome extension's origin must be listed here for it to call the API:
# load it unpacked, then copy the id from the extension's options page (it prints the exact
# origin). An unpacked extension gets a NEW id on every reload unless the manifest pins a `key`,
# so re-check this after reloading it.
#   CORS_ORIGINS=http://localhost:5173,chrome-extension://abcdefghijklmnopabcdefghijklmnop
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
 